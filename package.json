{
  "name": "nexora-ai",
  "version": "0.8.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "test:contracts": "node --no-warnings --experimental-strip-types --test scripts/*contract.test.mjs",
    "ci:preflight": "node scripts/ci-preflight.mjs",
    "validate:repo": "node scripts/validate-repo.mjs",
    "security:check": "node scripts/security-check.mjs",
    "dataset:validate": "python training/scripts/validate_dataset.py training/datasets/nexora-devsec-sample.jsonl",
    "docker:config:vps": "cp .env.vps.example .env.production && docker compose -f docker-compose.vps.yml config"
  },
  "dependencies": {
    "next": "16.3.0",
    "pg": "^8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/pg": "^8.15.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "typescript": "5.7.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
