NODE_ENV=production
APP_ENV=vps
APP_NAME="Nexora AI"
APP_VERSION=0.9.0

# Dominios públicos de producción apuntados a la VPS.
PUBLIC_DOMAIN=ghostnexoraai.duckdns.org
API_DOMAIN=apighostnexoraai.duckdns.org
NEXT_PUBLIC_SITE_URL=https://ghostnexoraai.duckdns.org
NEXT_PUBLIC_API_URL=https://apighostnexoraai.duckdns.org
MOBILE_PRODUCTION_API_URL=https://apighostnexoraai.duckdns.org/
ANDROID_APK_URL=https://ghostnexoraai.duckdns.org/downloads/NexoraAI-latest.apk
NEXORA_RELEASE_DIR=/opt/nexora-ai/releases
NEXORA_RELEASE_MANIFEST_PATH=/var/lib/nexora-ai/releases/latest.json

AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_MODEL_ASSISTANT=qwen2.5-coder:7b
OLLAMA_VISION_MODEL=gemma3:4b
OLLAMA_MODEL_PLANNER=qwen2.5-coder:7b
OLLAMA_MODEL_SPECIALIST=qwen2.5-coder:7b
OLLAMA_MODEL_REVIEWER=qwen2.5-coder:7b
OLLAMA_MODEL_SECURITY=qwen2.5-coder:7b
OLLAMA_MODEL_TESTER=qwen2.5-coder:7b
OLLAMA_MODEL_CRITIC=qwen2.5-coder:7b
OLLAMA_MODEL_SYNTHESIZER=qwen2.5-coder:7b
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_THREAD=0
OLLAMA_INSTANT_TIMEOUT_MS=180000
OLLAMA_MEDIUM_TIMEOUT_MS=240000
OLLAMA_HIGH_TIMEOUT_MS=300000
OLLAMA_MAXIMUM_TIMEOUT_MS=360000
OLLAMA_INSTANT_FINAL_TOKENS=384
OLLAMA_MEDIUM_WORKER_TOKENS=256
OLLAMA_MEDIUM_FINAL_TOKENS=512
OLLAMA_HIGH_WORKER_TOKENS=256
OLLAMA_HIGH_FINAL_TOKENS=700
OLLAMA_MAXIMUM_WORKER_TOKENS=224
OLLAMA_MAXIMUM_FINAL_TOKENS=900
OLLAMA_MULTI_AGENT_PARALLEL=false
OLLAMA_KEEP_ALIVE=15m

DATABASE_URL=postgresql://nexora:CHANGE_THIS_PASSWORD@postgres:5432/nexora_ai
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD
CHAT_JOB_STALE_MINUTES=25

# Autenticación móvil autohospedada.
# Los secretos OAuth viven solamente en la API/VPS, nunca dentro del APK.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Nexora Mail: servicio transaccional de salida incluido en la propia VPS.
# No abre SMTP/IMAP/POP3 al exterior. La API se comunica con él únicamente
# por la red privada de Docker mediante http://mailer:8025/send.
MAIL_DOMAIN=ghostnexoraai.duckdns.org
MAIL_HOSTNAME=ghostnexoraai.duckdns.org
MAIL_FROM=noreply@ghostnexoraai.duckdns.org
MAIL_DKIM_SELECTOR=nexora

# Opcionales pero recomendados. Si una instalación existente no contiene
# estas variables, Nexora 0.9 deriva secretos distintos de POSTGRES_PASSWORD
# para que `nexora update` pueda migrar sin intervención y sin perder datos.
# Después puedes sustituirlos por: openssl rand -hex 32
AUTH_CODE_PEPPER=
AUTH_EMAIL_WEBHOOK_SECRET=

# Compilador efímero de aplicaciones solicitadas por usuarios.
ENABLE_USER_ANDROID_BUILDS=false
USER_BUILD_JOBS_PATH=/var/lib/nexora-ai/android-build-jobs
USER_BUILD_GRADLE_CACHE=/opt/nexora-ai/cache/user-gradle
USER_BUILD_SECRET_DIR=/opt/nexora-ai/secrets/user-builds
USER_BUILD_MAX_PER_HOUR=3
USER_BUILD_MAX_QUEUED=10
USER_BUILD_RATE_LIMIT_SALT=CHANGE_WITH_ANOTHER_RANDOM_SECRET
ENABLE_DANGEROUS_TOOLS=false
ALLOW_CODE_EXECUTION=false
SANDBOX_RUNNER_URL=http://sandbox:8787
SANDBOX_RUNNER_TOKEN=CHANGE_WITH_AT_LEAST_24_RANDOM_CHARACTERS
SANDBOX_JOBS_PATH=/var/lib/nexora-ai/sandbox-jobs
SANDBOX_TIMEOUT_MS=30000
SANDBOX_MAX_OUTPUT_BYTES=12000
SANDBOX_MAX_CONCURRENT_JOBS=2
ALLOW_GITHUB_WRITE=false
REQUIRE_EXPLICIT_CONFIRMATION=true
RATE_LIMIT_PER_MINUTE=80
