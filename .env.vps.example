NODE_ENV=production
APP_ENV=vps
APP_NAME="Nexora AI"
APP_VERSION=0.1.0-vps-ci
NEXT_PUBLIC_SITE_URL=https://nexoraia.com
NEXT_PUBLIC_API_URL=https://api.nexoraia.com
MOBILE_PRODUCTION_API_URL=https://api.nexoraia.com/
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5-coder:7b
DATABASE_URL=postgresql://nexora:CHANGE_THIS_PASSWORD@postgres:5432/nexora_ai
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD
ENABLE_DANGEROUS_TOOLS=false
ALLOW_CODE_EXECUTION=false
ALLOW_GITHUB_WRITE=false
REQUIRE_EXPLICIT_CONFIRMATION=true
RATE_LIMIT_PER_MINUTE=80
